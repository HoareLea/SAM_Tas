<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows: the TAS route drives EDSL COM servers (64-bit) and SAM.Analytical.Tas
         pulls in WindowsForms; the CLI is invoked as `benchmark-tas` (see Program.cs / README).
         This project references the TAS COM interop transitively, so it must be built with the
         .NET Framework MSBuild (ResolveComReference) — the repo solution build does this. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SAM.Analytical.Tas.Benchmark</RootNamespace>
    <AssemblyName>benchmark-tas</AssemblyName>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Ship benchmark-tas in the repo-level build\ folder like every other SAM_Tas project, so
         CI's `**\build\*` artifact upload includes the executable (and its dependencies). -->
    <OutputPath>..\..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- COM-free producer core (ToBenchmark / TasBenchmarkContext / Producer). -->
    <ProjectReference Include="..\SAM.Analytical.Tas.Benchmark\SAM.Analytical.Tas.Benchmark.csproj" />
    <!-- Same-repo main library (brings SAM.Core.Tas / SAM.Weather.Tas / SAM.Geometry.Tas and the
         TAS COM interop). Two `..`: the CLI sits under benchmark\ in the repo. -->
    <ProjectReference Include="..\..\SAM_Tas\SAM.Analytical.Tas\SAM.Analytical.Tas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Benchmark schema (B1a): the CLI drives BenchmarkCliHost / arguments / serializer directly. -->
    <Reference Include="SAM.Analytical.Benchmark">
      <HintPath>..\..\..\SAM_Validation\build\SAM.Analytical.Benchmark.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Architectural">
      <HintPath>..\..\..\SAM\build\SAM.Architectural.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Weather">
      <HintPath>..\..\..\SAM\build\SAM.Weather.dll</HintPath>
    </Reference>
    <!-- gbXML export: feeds the same shared gbXML into TAS when one is not supplied. -->
    <Reference Include="SAM.Analytical.gbXML">
      <HintPath>..\..\..\SAM_gbXML\build\SAM.Analytical.gbXML.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.gbXML">
      <HintPath>..\..\..\SAM_gbXML\build\SAM.Core.gbXML.dll</HintPath>
    </Reference>
    <Reference Include="gbXMLSerializer">
      <HintPath>..\..\..\SAM_gbXML\references\gbXMLSerializer.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
